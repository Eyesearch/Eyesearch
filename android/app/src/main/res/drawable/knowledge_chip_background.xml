<?xml version="1.0" encoding="utf-8"?>
<!-- A pill for a secondary knowledge card. A shape rather than a Material chip
     style, because the app theme is AppCompat and a Material3 style would not
     resolve under it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chip_surface" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
