<?xml version="1.0" encoding="utf-8"?>
<!--
  Home → Results. History is a separate activity and the profile is a dialog, so
  they are deliberately not part of this graph.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home_dest">

    <fragment
        android:id="@+id/home_dest"
        android:name="com.eyesearch.app.home.HomeFragment"
        android:label="home">

        <action
            android:id="@+id/action_home_to_results"
            app:destination="@id/results_dest"
            app:launchSingleTop="false" />
    </fragment>

    <fragment
        android:id="@+id/results_dest"
        android:name="com.eyesearch.app.results.ResultsFragment"
        android:label="results">

        <argument
            android:name="query"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>
